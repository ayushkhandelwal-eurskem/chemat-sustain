# CheMatSustain environment configuration template.
#
# Copy to `.env` and fill in real values. NEVER commit `.env` (it is in
# .gitignore) and NEVER put a real secret in THIS file - only names, defaults
# and descriptions belong here.
#
# Full production reference, including the two-stage cutover and the defaults
# that are wrong for this deployment:
#     docs/security/production-env-reference.md
#
# Every variable below is one the code actually reads. Verified against
# backend/security/config.py, backend/utils/oidc.py, backend/api/services/user.py
# and keycloak/build_realm.py on 2026-08-03.


# =============================================================================
# STAGE 1 - safe to set today
# =============================================================================

# --- Database ------------------------------------------------------------
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# REQUIRED. backend/utils/db.py reads this at import time via
# get_settings().database_url, and config.py raises "DATABASE_URL is required"
# when it is absent - the backend will not start without it. It is NOT derived
# from the POSTGRES_* values above in docker-compose.yml.
#
# Compose does NOT expand ${...} inside an env_file, so write literal values,
# not references. Host is the compose service name.
#   Stage 1: postgresql+asyncpg://<POSTGRES_USER>:<POSTGRES_PASSWORD>@db:5432/<POSTGRES_DB>
#   Stage 2: swap the credentials to chemat_app - that is what activates RLS.
DATABASE_URL=

# The unprivileged runtime role created by migration 001/003. Not read by the
# application directly; it belongs inside DATABASE_URL at Stage 2. Kept as its
# own variable so it can be set with ALTER ROLE and rotated independently.
CHEMAT_APP_PASSWORD=

# --- Environment ---------------------------------------------------------
# Leave as "development" until the cutover. See the WARNING under Stage 2:
# APP_ENV=production forces AUTH_MODE=keycloak and ENABLE_LEGACY_API=false,
# which removes the routers the current site and its login depend on.
APP_ENV=development

# "legacy" (session + OTP, current) or "keycloak" (OIDC bearer tokens).
AUTH_MODE=legacy

# Defaults to TRUE. Keeps /tests, /users, /files, tree and protocol-file
# routers mounted. Must be false once APP_ENV=production.
ENABLE_LEGACY_API=true

# Defaults to false. SQLAlchemy create_all at startup - development only.
ENABLE_AUTO_DDL=false

# Publishes /docs, /redoc and /openapi.json. Defaults to false.
# These were found serving 38 endpoints anonymously in production on
# 2026-08-03. Leave false everywhere except local development.
ENABLE_API_DOCS=false

# Exact browser origins, comma separated. Default is http://localhost:3000,
# which is wrong for production. A literal "*" is rejected by validate().
CORS_ORIGINS=https://database.eurskem.com

# HMAC key for the audit hash chain. Required once APP_ENV=production.
# Generate with: openssl rand -hex 32
# Keep a copy - rotating it breaks verification of the existing chain.
AUDIT_HMAC_KEY=

# --- File storage --------------------------------------------------------
# Both MUST match bind mounts in docker-compose.yml. TENANT_DATA_ROOT defaults
# to /data/tenants, which is NOT mounted: files written there live in the
# container's writable layer and are destroyed by the next `up --build`. That
# already happened once, leaving 327 test rows pointing at 24 surviving files.
PROTOCOL_FILE_DIR=/app/protocol_files
TENANT_DATA_ROOT=/app/data

# Maximum upload size in bytes. Defaults to 26214400 (25 MiB).
MAX_UPLOAD_BYTES=26214400

# --- Keycloak: identity provider ----------------------------------------
# Dedicated Postgres for Keycloak. Never share the application database.
KEYCLOAK_DB_USER=
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_DB_NAME=

# Bootstrap admin, applied on Keycloak's FIRST boot only. Changing these later
# has no effect on an initialised instance - use the admin console, or
# `kc.sh bootstrap-admin user` inside the container, instead.
KEYCLOAK_ADMIN_USERNAME=
KEYCLOAK_ADMIN_PASSWORD=

# The realm name. The code default is "chemat-sustain"; the actual realm is
# "chematsustain", with NO hyphen. The default names a realm that does not
# exist, and provisioning against it fails.
KEYCLOAK_REALM=chematsustain

# Read by backend/security/config.py (current validation path).
KEYCLOAK_ISSUER=https://auth.eurskem.com/realms/chematsustain
KEYCLOAK_JWKS_URL=https://auth.eurskem.com/realms/chematsustain/protocol/openid-connect/certs

# Must equal the `aud` claim tokens actually carry. That comes from the
# `organisation` client scope's `chematsustain-api-audience` mapper. auth.py
# sets verify_aud=True, so a wrong value here 401s every request.
KEYCLOAK_AUDIENCE=chematsustain-api

# Read by backend/utils/oidc.py, the LEGACY validation path, which uses
# different names for the same two values. Both naming schemes coexist while
# the migration is in progress; keep them consistent with each other.
KEYCLOAK_ISSUER_URL=https://auth.eurskem.com/realms/chematsustain
KEYCLOAK_BACKEND_AUDIENCE=chematsustain-api

# Browser-facing client IDs accepted as `azp`, comma separated. Empty default.
KEYCLOAK_ALLOWED_AZP=portal-frontend

# Machine clients are accepted when `azp` starts with this prefix. The code
# default is "chemat-app-", which matches no client you would create - partner
# clients are named partner-<alias>. A mismatch is a flat 403
# "Token client is not authorised".
KEYCLOAK_MACHINE_AZP_PREFIX=partner-

# --- Keycloak Admin API (provisioning) ----------------------------------
# Leave provisioning false unless actively provisioning; when true, all four
# of the following are required or startup fails.
ENABLE_KEYCLOAK_PROVISIONING=false
# Internal Docker address. The public /admin path is blocked at nginx, so an
# external URL returns 403.
KEYCLOAK_ADMIN_BASE_URL=http://keycloak:8080
KEYCLOAK_ADMIN_CLIENT_ID=
KEYCLOAK_ADMIN_CLIENT_SECRET=

# --- Outbound email (OTP delivery for legacy login) ---------------------
# NAMES MATTER: api/services/user.py reads SMTP_SENDER and SMTP_PASSWORD.
# Earlier versions of this template said SMTP_SENDER_EMAIL and
# SMTP_SENDER_PASSWORD, which the code never reads - so OTP delivery failed
# with "OTP delivery is unavailable because SMTP is not configured" while the
# variables looked populated.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SENDER=
# The account used to AUTHENTICATE, when it differs from the From address.
# Gmail requires them to be identical, so leave this unset for Gmail. Brevo,
# Mailgun and SES use an account login or API key name distinct from the
# verified sender - set it there. Defaults to SMTP_SENDER when unset.
SMTP_USERNAME=
# Gmail app password: Google Account > Security > 2-Step Verification >
# App passwords. Never the account's own login password.
SMTP_PASSWORD=

# --- Session / logging ---------------------------------------------------
# Hours a legacy login session stays valid. Defaults to 168 (7 days).
SESSION_EXPIRE_HOURS=168
# MUST be true anywhere served over TLS. "false" only for plain-HTTP local dev.
SESSION_COOKIE_SECURE=true
LOG_LEVEL=INFO

# --- Realm build script (keycloak/build_realm.py) -----------------------
ADMIN_PASSWORD=

# --- Frontend (Next.js) --------------------------------------------------
# NEXT_PUBLIC_* values are inlined into the client bundle AT BUILD TIME and are
# publicly visible - never put a secret in one. Note that docker-compose.yml
# currently passes no env_file, environment or build args to the frontend
# service, so these are NOT reaching the build yet; that must be wired up
# before the OIDC login cutover.
NEXT_PUBLIC_AUTH_MODE=legacy
NEXT_PUBLIC_KEYCLOAK_ISSUER=https://auth.eurskem.com/realms/chematsustain
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=portal-frontend


# =============================================================================
# STAGE 2 - the cutover. Do NOT set these piecemeal.
# =============================================================================
#
# WARNING: APP_ENV=production is not a hardening flag. validate() makes it
# imply AUTH_MODE=keycloak and ENABLE_LEGACY_API=false, and the latter drops
# the /tests, /users, /files, tree and protocol-file routers - which is what
# the current site AND ITS LOGIN run on. Setting it early either refuses to
# boot or takes the platform down.
#
# Verified behaviour:
#   APP_ENV=production + AUTH_MODE=legacy   -> "Production requires AUTH_MODE=keycloak"
#   APP_ENV=production + keycloak, legacy api left default
#                                           -> "ENABLE_LEGACY_API must be false in production"
#
# Only after the pre-cutover gate in docs/security/production-env-reference.md:
#
#   APP_ENV=production
#   AUTH_MODE=keycloak
#   ENABLE_LEGACY_API=false
#   ENABLE_AUTO_DDL=false
#   NEXT_PUBLIC_AUTH_MODE=keycloak
#   DATABASE_URL=postgresql+asyncpg://chemat_app:<CHEMAT_APP_PASSWORD>@db:5432/<POSTGRES_DB>
#
# The DATABASE_URL change is what makes RLS actually enforce. Until then the
# app connects as a superuser and every policy is bypassed - the isolation
# tests pass, but production is not protected by them.
