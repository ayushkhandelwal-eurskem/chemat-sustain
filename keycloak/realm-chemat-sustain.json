{
  "realm": "chemat-sustain",
  "displayName": "CheMatSustain Consortium",
  "enabled": true,
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": false,
  "verifyEmail": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "failureFactor": 5,
  "defaultSignatureAlgorithm": "RS256",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 28800,
  "offlineSessionMaxLifespanEnabled": true,
  "offlineSessionMaxLifespan": 86400,
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA256",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "requiredActions": [
    {
      "alias": "CONFIGURE_TOTP",
      "name": "Configure OTP",
      "providerId": "CONFIGURE_TOTP",
      "enabled": true,
      "defaultAction": true,
      "priority": 10
    },
    {
      "alias": "VERIFY_EMAIL",
      "name": "Verify Email",
      "providerId": "VERIFY_EMAIL",
      "enabled": true,
      "defaultAction": true,
      "priority": 20
    }
  ],
  "roles": {
    "realm": [
      { "name": "platform_admin" },
      { "name": "api_owner" },
      { "name": "data_owner" },
      { "name": "security_approver" },
      { "name": "organisation_admin" },
      { "name": "researcher" },
      { "name": "developer" },
      { "name": "auditor" }
    ]
  },
  "clientScopes": [
    {
      "name": "chemat-tenant",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "false" },
      "protocolMappers": [
        {
          "name": "organisation_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "organisation_id",
            "claim.name": "organisation_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "chemat-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "chemat-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    { "name": "tests:read", "protocol": "openid-connect", "attributes": { "include.in.token.scope": "true" } },
    { "name": "experimental-data:read", "protocol": "openid-connect", "attributes": { "include.in.token.scope": "true" } },
    { "name": "protocol-files:read", "protocol": "openid-connect", "attributes": { "include.in.token.scope": "true" } },
    { "name": "protocol-files:download", "protocol": "openid-connect", "attributes": { "include.in.token.scope": "true" } },
    { "name": "files:navigate", "protocol": "openid-connect", "attributes": { "include.in.token.scope": "true" } },
    { "name": "files:read", "protocol": "openid-connect", "attributes": { "include.in.token.scope": "true" } },
    { "name": "audit:read-own-organisation", "protocol": "openid-connect", "attributes": { "include.in.token.scope": "true" } }
  ],
  "clients": [
    {
      "clientId": "chemat-api",
      "name": "CheMatSustain API audience",
      "enabled": true,
      "bearerOnly": true,
      "protocol": "openid-connect"
    },
    {
      "clientId": "chemat-portal",
      "name": "CheMatSustain Developer Portal",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "redirectUris": [
        "http://localhost:3000/auth/callback",
        "https://database.eurskem.com/auth/callback"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "https://database.eurskem.com"
      ],
      "defaultClientScopes": [
        "openid",
        "profile",
        "email",
        "roles",
        "chemat-tenant",
        "tests:read",
        "experimental-data:read",
        "protocol-files:read",
        "protocol-files:download",
        "files:navigate",
        "files:read",
        "audit:read-own-organisation"
      ]
    }
  ],
  "groups": [
    { "name": "consortium-partners", "subGroups": [] }
  ],
  "users": []
}
