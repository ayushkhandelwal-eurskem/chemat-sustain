# CheMatSustain environment configuration template.
#
# Copy to `.env` and fill in real values locally. NEVER commit `.env` itself
# (it is already listed in .gitignore) and NEVER put real secrets in this
# example file - only names and descriptions belong here.

# --- Database ---
# Credentials for the PostgreSQL instance used by docker-compose / docker-compose-dev.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Full async SQLAlchemy connection string. In docker-compose-dev.yml this is
# derived from the POSTGRES_* values above; set explicitly if running the
# backend outside Docker.
DATABASE_URL=

# --- Initial admin bootstrap ---
# If both are set, a single admin user is created on first startup if one
# does not already exist for this email. Leave unset to skip bootstrap.
# Use a long, unique, randomly generated password - never reuse a real password.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Session / auth ---
# Number of hours a login session remains valid. Defaults to 168 (7 days).
SESSION_EXPIRE_HOURS=
# Whether the session cookie requires HTTPS. Set to "true" in any environment
# served over TLS (production, and any dev setup fronted by HTTPS nginx).
# Only set to "false" for plain-HTTP local development.
SESSION_COOKIE_SECURE=
# Reserved for future signed-token use. Generate with e.g. `openssl rand -hex 32`.
SECRET_KEY=

# --- Outbound email (OTP delivery) ---
# SMTP relay used to send one-time-password emails during login.
SMTP_HOST=
SMTP_PORT=
# Mailbox the OTP emails are sent from.
SMTP_SENDER_EMAIL=
# App password / SMTP credential for the above mailbox. For Gmail, generate
# this under Google Account > Security > 2-Step Verification > App passwords.
# Never reuse the account's normal login password here.
SMTP_SENDER_PASSWORD=

# --- File storage ---
# Host-mounted directory the backend container uses for protocol/SOP file
# uploads. Must be a persistent Docker volume - see docker-compose.yml.
PROTOCOL_FILE_DIR=

# --- Application logging ---
# Standard Python logging level for the backend (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=

# --- Keycloak (dev only, docker-compose-dev.yml) ---
# Dedicated Postgres instance for Keycloak - never share this database with
# the application database above.
KEYCLOAK_DB_USER=
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_DB_NAME=
# Bootstrap admin account created on Keycloak's first boot. Use a long,
# unique, randomly generated password - this is the realm's superuser.
KEYCLOAK_ADMIN_USERNAME=
KEYCLOAK_ADMIN_PASSWORD=
# Base URL the backend uses to reach Keycloak for JWKS/token validation.
KEYCLOAK_ISSUER_URL=
# OAuth2 client ID(s) the backend accepts as a valid audience/azp.
KEYCLOAK_BACKEND_AUDIENCE=
