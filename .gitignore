.ssh
certs/
.env

# Local data and uploads - never committed.
#
# On the production host these live INSIDE the repository directory
# (/home/chematsustain/{protocol_files,research_data}) because that is where the
# compose bind mounts point, so they must be ignored explicitly or a `git add -A`
# would publish real research data to a public repo.
data
backend/protocol_files/
protocol_files/
research_data/
backend/data/

# Database dumps, data exports and backups.
#
# A production dump containing real user data and restricted research records
# was committed to this public repository once already (see
# docs/security/incident-2026-08-credential-and-data-exposure.md). These
# patterns are deliberately shaped to catch data-export filenames while
# keeping legitimate schema/seed scripts (seed_categories.sql,
# backend/setup_tree.sql) tracked - hence not a blanket *.sql.
*backup*.sql
*backup*.tar.gz
*_backup*.tar.gz
*dump*.sql
*_data.sql
*_live*.sql
*.dump
prod-backups/
backups/
node_modules

# pytest/hypothesis local cache
.hypothesis/
